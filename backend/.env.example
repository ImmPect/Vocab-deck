# Скопируйте в .env и при необходимости измените. Файл .env в git не попадает.
ENV=dev
# Локально — SQLite-файл; в производственной среде — PostgreSQL:
# DATABASE_URL=postgresql+psycopg://vocab:vocab@localhost:5432/vocabdeck
DATABASE_URL=sqlite:///./vocabdeck.db
SECRET_KEY=dev-secret-change-me
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
# Учётная запись администратора для локальной разработки (создаёт python -m app.seed)
ADMIN_EMAIL=admin@vocabdeck.local
ADMIN_PASSWORD=VocabAdmin2026
